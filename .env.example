# MongoDB Atlas Configuration
# Replace <USERNAME>, <PASSWORD>, and <CLUSTER_HOST> with your credentials in .env (never commit .env)
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.mndhh.mongodb.net/studyclock?appName=Cluster0
MONGODB_DB=studyclock

# JWT & Authentication Secret (Generate a strong 32+ char random string)
JWT_SECRET=generate_a_random_32_character_secret_string_here
